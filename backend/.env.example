# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key

# ── AI Provider ───────────────────────────────────────────────────────────────
# Switch to: ollama | openrouter | anthropic | groq
AI_PROVIDER=openrouter

# OpenRouter (production — Claude Sonnet 4.6)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# Ollama (local dev)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
MAIN_MODEL=gemma3:27b
FAST_MODEL=gemma3:4b

# ── Embeddings ────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...
# text-embedding-004 (768d) — used for semantic memory + annotation search

# ── Stripe (Sprint 6 — creator economy) ──────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Strava ────────────────────────────────────────────────────────────────────
STRAVA_CLIENT_ID=your-strava-app-id
STRAVA_CLIENT_SECRET=your-strava-secret
STRAVA_REDIRECT_URI=http://localhost:8000/integrations/strava/callback

# ── Google Calendar / OAuth ───────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback
GOOGLE_PROJECT_ID=your-gcp-project

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:8000
ASSISTANT_NAME=Aly
# ADMIN_SECRET=change-me-before-production

# ── Known gotchas ─────────────────────────────────────────────────────────────
# - Never mix FastEmbed (384d) and Gemini embeddings (768d) in the same vector column
# - Set AI_PROVIDER=openrouter for production; ollama for local dev
# - Run schema_v24_ratings.sql in Supabase before enabling marketplace ratings
# - OPENROUTER_MODEL must be anthropic/claude-sonnet-4-6 (deadline: June 1 2026)
